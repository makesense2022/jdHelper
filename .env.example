# DeepSeek API Credentials
DEEPSEEK_API_KEY=your_api_key_here

# Model Configuration
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# Server Configuration
PORT=3001

# API 防护(部署到公网时必填)
# LEARN_API_KEY:服务端要求每个请求携带 x-api-key 头等于此值,否则返回 401。
#   - 生产环境(NODE_ENV=production)强制启用;未配置则返回 503。
#   - 开发环境不校验,便于本地调试。
# NEXT_PUBLIC_LEARN_API_KEY:构建时注入前端,让页面自动携带 x-api-key 头。
#   注意:NEXT_PUBLIC_ 前缀的值会出现在浏览器产物中,仅供"防陌生人滥用"级别防护;
#   如需真正确保只有本人可用,请加登录鉴权。
LEARN_API_KEY=
NEXT_PUBLIC_LEARN_API_KEY=

# Website foundation. Set production values on the hosting provider before the next authorized deployment.
# Project ingestion key only; never a personal PostHog API token.
POSTHOG_KEY=
POSTHOG_HOST=
POSTHOG_MODE=production
SITE_URL=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_MODE=production
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
